# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.local.example is committed as a template.
#
# Where to find these:
#   1. Open https://supabase.com/dashboard
#   2. Pick your project (or create one)
#   3. Project Settings → API
#   4. Copy "Project URL" and the "anon public" key (NOT the service_role key)
#
# If you'd rather run Supabase locally:
#   brew install supabase/tap/supabase
#   supabase start
# The CLI prints the local URL and anon key when it boots.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — only needed if you wire up the Google Analytics dashboard.
# Provide either GOOGLE_SERVICE_ACCOUNT_JSON (one-line JSON blob) OR
# the email + private key pair.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional — Sentry error tracking. Leave blank for local dev. To activate:
#   1. Create a project at https://sentry.io
#   2. Copy the DSN into both vars below (server + client).
#   3. (Optional) For source map upload during deploy, add an auth token:
#      https://sentry.io/settings/account/api/auth-tokens/  with `project:releases`
# Errors only fire when NODE_ENV=production, so dev stays quiet either way.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
